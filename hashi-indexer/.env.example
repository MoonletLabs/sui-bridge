# Copy to .env (on a Hashi host) or .env.local.mainnet / .env.local.testnet (locally) and fill in.
# Never commit the copy.

# mainnet or testnet: one network per stack
NETWORK=mainnet

HASHI_ADMIN_PASSWORD=change-me
HASHI_WRITER_PASSWORD=change-me
HASHI_READER_PASSWORD=change-me

# Port of the database, used both inside the container and on the host (so a firewall rule for it
# works). 5433 on the Hashi hosts (5432 is taken on the testnet host); locally 5544 for mainnet and
# 5545 for testnet.
DB_PORT=5433
# 127.0.0.1 = this machine only. On a Hashi host, bind the interface the dashboard reaches.
DB_BIND=127.0.0.1

SNAPSHOT_SECONDS=600
EVENT_SECONDS=60
# Event history read on the first run. Leave empty for the default (mainnet: all, testnet: 3 days).
BACKFILL_DAYS=
# Pages (50 events each) read per event type per run. Empty = 100. A long backfill window is finished
# over several runs.
EVENTS_MAX_PAGES_PER_RUN=

# Image to run: a released version (see the repository's releases), for example
#   ghcr.io/moonletlabs/hashi-indexer:1.0
# or, stricter, its digest:  ghcr.io/moonletlabs/hashi-indexer@sha256:<digest>
HASHI_INDEXER_IMAGE=ghcr.io/moonletlabs/hashi-indexer:1.0
# Local only (building from source): add
#   COMPOSE_FILE=docker-compose.yml:docker-compose.build.yml
#   HASHI_INDEXER_IMAGE=hashi-indexer:local
