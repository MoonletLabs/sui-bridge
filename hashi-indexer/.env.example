# Copy to .env (on a Hashi host, next to docker-compose.yml) or .env.local.mainnet / .env.local.testnet
# (locally) and fill in. If an older .env.local.* has COMPOSE_FILE or HASHI_INDEXER_IMAGE lines, delete them.
# Never commit the copy.

# mainnet or testnet: one network per stack
NETWORK=mainnet

HASHI_ADMIN_PASSWORD=change-me
HASHI_WRITER_PASSWORD=change-me
HASHI_READER_PASSWORD=change-me

# Port of the database, used both inside the container and on the host (so a firewall rule for it
# works). 5433 on the Hashi hosts (5432 is taken on the testnet host); locally 5544 for mainnet and
# 5545 for testnet.
DB_PORT=5433
# 127.0.0.1 = this machine only. On a Hashi host, bind the interface the dashboard reaches.
DB_BIND=127.0.0.1

# Prometheus metrics (/metrics), published on the host's loopback for the monitoring agent. 9199 on the
# Hashi hosts; locally use another port per network (e.g. 9199 for mainnet, 9198 for testnet).
# 0 turns metrics off.
METRICS_PORT=9199

SNAPSHOT_SECONDS=600
EVENT_SECONDS=60
# Event history read on the first run. Leave empty for the default (mainnet: all, testnet: 7 days).
BACKFILL_DAYS=
# Pages (50 events each) read per event type per run. Empty = 100. A long backfill window is finished
# over several runs.
EVENTS_MAX_PAGES_PER_RUN=
